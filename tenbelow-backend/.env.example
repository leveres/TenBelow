# Local backend secrets — copy to `.env` and fill in. Do not commit `.env`.
# Stripe end-of-week guide: ../../docs/stripe-setup.md

# --- Stripe (buyer checkout + Connect payouts) ---
# Test mode first: sk_test_… from Dashboard → Developers → API keys
STRIPE_SECRET_KEY=
# From Dashboard → Developers → Webhooks → endpoint signing secret (whsec_…)
# URL must be: https://<your-host>/webhook  Events: payment_intent.succeeded (minimum)
STRIPE_WEBHOOK_SECRET=

BACKEND_URL=http://localhost:3000
# Must match iOS TENBELOW_APP_API_KEY (Xcode build setting)
APP_API_KEY=
# Buyer/seller JWT signing (set on Render; can differ from APP_API_KEY)
AUTH_JWT_SECRET=
ADMIN_API_KEY=
# Optional: custom order alerts and legacy admin email hooks
ADMIN_LOGIN_EMAIL=
CUSTOM_ORDER_ADMIN_EMAIL=
# Development only: lets scripts call admin APIs with X-Admin-Key/Bearer.
ADMIN_ALLOW_DIRECT_KEY_AUTH=false
RESEND_API_KEY=
EMAIL_FROM=

# Media upload limits (bytes) and rate limits.
MEDIA_SELLER_IMAGE_MAX_BYTES=12582912
MEDIA_SELLER_VIDEO_MAX_BYTES=52428800
MEDIA_EXCHANGE_IMAGE_MAX_BYTES=12582912
MEDIA_EXCHANGE_VIDEO_MAX_BYTES=52428800
MEDIA_CUSTOM_ORDER_REF_MAX_BYTES=11534336
MEDIA_UPLOAD_RATE_LIMIT_MAX=120
MEDIA_READ_RATE_LIMIT_MAX=2000
# Optional future hook for async malware scanning after upload.
# MEDIA_SCAN_WEBHOOK_URL=

# Apple Push Notifications. Use APNS_ENV=sandbox for development/device testing,
# then APNS_ENV=production for App Store/TestFlight production pushes.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.innovativecodeworks.com.TenBelow
APNS_PRIVATE_KEY=
APNS_ENV=sandbox

# Optional Postgres
# DATABASE_URL=
# PG_READS=0
