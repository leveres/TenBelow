STRIPE_SECRET_KEY=sk_test_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET
RESEND_API_KEY=re_YOUR_KEY
EMAIL_FROM=TenBelow <orders@yourdomain.com>

# Remote catalog / config (optional)
CATALOG_URL=https://yourhost/products.json
CONFIG_URL=https://yourhost/config.json

# Sellers directory (optional — falls back to local sellers.json)
SELLERS_URL=https://yourhost/sellers.json

# Backend public URL (for Stripe onboarding redirects)
BACKEND_URL=http://localhost:3000

# Persistent backend data directory (mount your host disk here in production)
# BACKEND_DATA_DIR=/absolute/path/to/backend-data

# Apple Push Notification service (HTTP/2 + .p8 key). Device tokens are stored in push_devices.json (gitignored).
# Match APNS_USE_PRODUCTION to your app build: Debug/dev → unset or 0 (sandbox). App Store / TestFlight → 1 (production).
APNS_KEY_PATH=/absolute/path/AuthKey_XXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
# Optional; defaults to com.innovativecodeworks.com.TenBelow
# APNS_BUNDLE_ID=com.innovativecodeworks.com.TenBelow
# APNS_USE_PRODUCTION=1

# Seller membership product ID used for App Store sync
SELLER_SUBSCRIPTION_PRODUCT_ID=com.innovativecodeworks.com.TenBelow.seller.monthly

# Stripe webhook route on your deployed server:
# https://your-backend-domain.com/webhook

# App Store Server API (server-to-server subscription verification). When set, POST /seller-membership-sync
# ignores client isActive/expiresAt and uses Apple's Get All Subscription Statuses + JWS verification.
# Download root CAs into tenbelow-backend/certs/ (see Apple PKI) — G2/G3 .cer files are included in the repo.
APP_STORE_ISSUER_ID=your-issuer-uuid
APP_STORE_KEY_ID=your-key-id
# Either inline PEM (use \n for newlines) or path to the App Store Connect API .p8 file:
APP_STORE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APP_STORE_PRIVATE_KEY_PATH=/absolute/path/AuthKey_XXXXX.p8
APP_STORE_BUNDLE_ID=com.innovativecodeworks.com.TenBelow
# sandbox | production (must match where the subscription was purchased)
APP_STORE_SERVER_ENV=sandbox
# Numeric App Store app ID from App Store Connect — required when APP_STORE_SERVER_ENV=production
# APP_STORE_APP_APPLE_ID=1234567890
