{
  "name": "tenbelow-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:production": "npm run prisma:migrate:deploy && npm run sync:legal-documents && node server.js",
    "setup:postgres:phase1": "node scripts/setup-postgres-phase1.mjs",
    "repair:prisma:phase1": "node scripts/repair-prisma-phase1-schema.mjs",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node --check admin/admin-review.js && node scripts/verify-product-colors.mjs",
    "prisma:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://127.0.0.1:5432/tenbelow} prisma generate",
    "prisma:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://127.0.0.1:5432/tenbelow} prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "migrate:prisma:dry-run": "node scripts/prisma-migration-dry-run.mjs",
    "sync:prisma:phase1": "node scripts/sync-json-to-prisma-phase1.mjs",
    "sync:legal-documents": "node scripts/sync-legal-agreement-documents.mjs",
    "generate:seller-agreement-pdf": "node scripts/generate-seller-agreement-pdf.mjs",
    "test:seller-welcome-email": "node scripts/test-seller-welcome-email.mjs",
    "verify:prisma:phase1": "node scripts/verify-prisma-phase1.mjs",
    "test:media-storage": "node scripts/test-media-storage.mjs",
    "print:media-storage-checklist": "node scripts/print-media-storage-checklist.mjs",
    "migrate:disk-media-to-r2": "node scripts/migrate-disk-media-to-r2.mjs",
    "rewrite:json-media-urls": "node scripts/rewrite-json-media-urls.mjs",
    "setup:r2-production": "node scripts/setup-r2-production.mjs",
    "migrate:json-to-pg": "node scripts/migrate-json-to-pg.mjs",
    "migrate:json-to-pg-relational": "node scripts/migrate-json-to-pg-relational.mjs",
    "verify:pg-relational": "node scripts/verify-pg-relational.mjs",
    "smoke:core": "node scripts/smoke-core-endpoints.mjs",
    "release:checklist": "node scripts/release-checklist.mjs",
    "load-test:catalog": "node scripts/load-test-catalog.mjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.0.0",
    "@aws-sdk/client-s3": "^3.758.0",
    "@prisma/client": "^6.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.5",
    "pdfkit": "^0.17.2",
    "pg": "^8.14.0",
    "resend": "^4.1.2",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "prisma": "^6.8.2"
  }
}
